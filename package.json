{
  "name": "my-clinic-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "/* Linter & Formatter 保存時以外の一括チェック用 */": "echo 'Run lint and format'",
    "lint": "biome check . && eslint .",
    "format": "biome format --write .",
    "/*Supabase DBのテーブル定義からTypeScript型ファイルを自動生成 */ ": "echo 'Sync database types'",
    "gen-types": "bunx supabase gen types typescript --project-id 'nyqvxihzbbfgzxghuzju' > src/types/database.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.36.0",
    "@internationalized/date": "^3.12.0",
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/router-core": "^1.15.0",
    "@tanstack/router-devtools": "^1.166.11",
    "@tanstack/solid-form": "^1.28.6",
    "@tanstack/solid-query-devtools": "^5.96.0",
    "@tanstack/solid-router": "^1.15.0",
    "@tanstack/solid-router-devtools": "^1.166.11",
    "@tanstack/zod-adapter": "^1.166.9",
    "ark-ui": "^0.0.4",
    "arktype": "^2.2.0",
    "date-fns": "^4.1.0",
    "jaconv": "^1.1.2",
    "libphonenumber-js": "^1.12.41",
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/router-plugin": "^1.167.12",
    "@tanstack/router-vite-plugin": "^1.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-solid": "^0.13.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^7.0.0",
    "vite": "^8.0.8",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.4"
  }
}
