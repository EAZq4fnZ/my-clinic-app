{
	"name": "my-clinic-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"serve": "vite preview",

		"/* Linter & Formatter 保存時以外の一括チェック用 */": "echo 'Run lint and format'",
		"lint": "biome check . && eslint .",
		"format": "biome format --write .",

		"/*Supabase DBのテーブル定義からTypeScript型ファイルを自動生成 */ ": "echo 'Sync database types'",
		"gen-types": "bunx supabase gen types typescript --project-id 'nyqvxihzbbfgzxghuzju' > src/types/database.ts"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.39.0",
		"@tanstack/router-core": "^1.15.0",
		"@tanstack/solid-router": "^1.15.0",
		"solid-js": "^1.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.7.0",
		"@tanstack/router-vite-plugin": "^1.15.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"eslint-plugin-solid": "^0.13.0",
		"typescript": "^5.3.0",
		"typescript-eslint": "^7.0.0",
		"vite": "^5.0.0",
		"vite-plugin-solid": "^2.8.0"
	}
}
